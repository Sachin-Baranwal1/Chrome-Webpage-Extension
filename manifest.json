{
  "manifest_version": 3,
  "name": "Creative Homepage",
  "version": "1.3",
  "description": "Offline productivity new tab with custom backgrounds",

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "permissions": ["storage"],
  "host_permissions": [
    "https://api.openweathermap.org/*"
  ],

  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
